# ============================================
# Oracle Cloud CI/CD 배포 설정
# 이 파일을 .env.deploy로 복사하여 실제 값을 입력하세요.
# ============================================

# --- 배포 대상 ---
# "compute" = OCI Compute + Docker Compose
# "oke"     = OKE (Oracle Kubernetes Engine)
DEPLOY_TARGET=compute

# --- OCI 기본 설정 ---
# OCI 리전 식별자 (예: ap-chuncheon-1, ap-seoul-1, us-ashburn-1)
OCI_REGION=ap-chuncheon-1

# OCI tenancy의 Object Storage namespace
# 확인: OCI 콘솔 → Tenancy Details → Object Storage Namespace
OCIR_NAMESPACE=your-namespace

# OCIR 리포지토리 접두어
OCIR_REPO_PREFIX=one-click-publishing

# OCI 사용자명 (OCIR 로그인용, 보통 이메일 형태)
OCI_USERNAME=your-email@example.com

# OCI Auth Token (OCIR 로그인용)
# 생성: OCI 콘솔 → Identity → Users → Auth Tokens → Generate Token
OCI_AUTH_TOKEN=your-auth-token

# --- OCI Compute 배포 설정 (DEPLOY_TARGET=compute 일 때) ---
# OCI Compute 인스턴스의 공인 IP
OCI_COMPUTE_HOST=123.456.789.0

# SSH 접속 사용자명 (Oracle Linux 기본값: opc)
OCI_COMPUTE_USER=opc

# SSH 개인키 파일 경로
OCI_SSH_KEY_PATH=~/.ssh/oci_compute_key

# --- OKE 배포 설정 (DEPLOY_TARGET=oke 일 때) ---
# OKE_CLUSTER_OCID=ocid1.cluster.oc1...
# OCI_TENANCY_OCID=ocid1.tenancy.oc1...
# OCI_USER_OCID=ocid1.user.oc1...
# OCI_FINGERPRINT=aa:bb:cc:dd:...
# OCI_API_KEY_PATH=~/.oci/oci_api_key.pem
